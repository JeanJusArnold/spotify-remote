# Copy to .env and fill in only what applies to your own Spotify account.
# Everything here is optional - unset variables just disable their workaround.

# Spotify playlist id that flips the web player to Arabic (sp_locale=ar)
# as soon as it's opened - a Spotify-side bug tied to this specific
# playlist's data, not something the app does. Find the id in the
# playlist's Spotify URL: open.spotify.com/playlist/<id>
ARABIC_LOCALE_BUG_PLAYLIST_ID=
