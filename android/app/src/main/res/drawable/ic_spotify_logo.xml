<?xml version="1.0" encoding="utf-8"?>
<!-- Ported 1:1 from the original web client's inline SVG background
     (public/css/style.css .topbar / .topbar::after) - the Spotify
     "soundwave" mark, drawn once and reused tinted gray (static
     watermark) and green (animated loading fill) in
     SpotifyRemoteHeader. The source's viewBox="0.95 0 24 24" (width=24
     height=24) crops a 0.95-unit sliver off the left of the path's own
     coordinate space; Android's vector viewport has no minX/minY offset
     to replicate that directly; a -0.95 group translateX does the same
     crop (shift the content left by 0.95, then the plain 24x24 viewport
     - matching the SVG's declared width/height exactly, not 24.95 -
     clips it identically). Widening the viewport instead of
     translating (an earlier version of this file did that) stretches a
     non-square 24.95:24 canvas into whatever square/rect size the icon
     is drawn at and leaves an empty sliver on the left that the SVG
     never showed, both making the rendered logo read slightly larger
     and shifted right of the original. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
