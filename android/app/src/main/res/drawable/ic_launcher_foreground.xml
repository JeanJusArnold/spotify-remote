<?xml version="1.0" encoding="utf-8"?>
<!-- One oversized KeyCap (see SpotifyRemoteHeader.kt's own KeyCap
     composable), centered - flat, no offset shadow slab beneath it
     anymore (removed the embossed 3D look). Face is 38x38 (35-73, both
     axes, kept square), a middle ground between the original 32x32 and
     a 44x44 attempt that touched the background gradient's own
     white/light-gray and mid-gray/dark-gray band transitions (see
     ic_launcher_background.xml) - no longer touching those exactly, but
     closer to them than the original size. Centered at (54,54), so the
     play glyph (tip still at y=54) didn't need to move. The play glyph
     is a hole punched through the face (evenOdd fillType), revealing
     the background gradient underneath directly, with a thin green
     outline traced over the edge. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#161616"
        android:strokeColor="#3D3D3D"
        android:strokeWidth="1.2"
        android:fillType="evenOdd"
        android:pathData="M41,35 H67 A6,6 0 0 1 73,41 V67 A6,6 0 0 1 67,73 H41 A6,6 0 0 1 35,67 V41 A6,6 0 0 1 41,35 Z M48.6,44.5 L64.9,54 L48.6,63.5 Z" />
    <!-- green outline traced over the cutout's edge -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#1DB954"
        android:strokeWidth="1.4"
        android:pathData="M48.6,44.5 L64.9,54 L48.6,63.5 Z" />
</vector>
