<?xml version="1.0" encoding="utf-8"?>
<!-- One oversized KeyCap (see SpotifyRemoteHeader.kt's own KeyCap
     composable), centered, slightly smaller than before (32x32 instead
     of 40x40, same shadow offset of 6) so the shadow's bottom edge
     lands exactly on the mid-gray/dark-gray band boundary at y=76. The
     play glyph (unchanged position/size, tip still at y=54) is a hole
     punched through BOTH the face and the shadow slab (evenOdd
     fillType, same triangle subtracted from each) with a thin green
     outline traced over the edge - a hole through the face alone would
     only reveal the shadow slab behind it, not the background layer
     underneath both. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#000000"
        android:fillType="evenOdd"
        android:pathData="M44,44 H64 A6,6 0 0 1 70,50 V70 A6,6 0 0 1 64,76 H44 A6,6 0 0 1 38,70 V50 A6,6 0 0 1 44,44 Z M48.6,44.5 L64.9,54 L48.6,63.5 Z" />
    <path
        android:fillColor="#161616"
        android:strokeColor="#3D3D3D"
        android:strokeWidth="1.2"
        android:fillType="evenOdd"
        android:pathData="M44,38 H64 A6,6 0 0 1 70,44 V64 A6,6 0 0 1 64,70 H44 A6,6 0 0 1 38,64 V44 A6,6 0 0 1 44,38 Z M48.6,44.5 L64.9,54 L48.6,63.5 Z" />
    <!-- green outline traced over the cutout's edge -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#1DB954"
        android:strokeWidth="1"
        android:pathData="M48.6,44.5 L64.9,54 L48.6,63.5 Z" />
</vector>
