# Example autostart script for a dedicated session running this
# project's Chromium instance. Written for Openbox (~/.config/openbox/autostart)
# - a minimal window manager is the point of a dedicated session at all,
# so there's little reason to reach for anything else here.

# Wait for PipeWire to be ready
until pactl info >/dev/null 2>&1; do
    sleep 0.2
done

# A virtual sink, used below as AudioRelay's capture point - not just
# a nice-to-have: AudioRelay was unreliable capturing straight from a
# normal/default output in earlier testing, this dedicated null sink
# is what made it work consistently. Nothing plays out of it on its
# own otherwise
# Create the virtual audio sink if it doesn't exist yet
if ! pactl list short sinks | grep -q "spotify-remote-audio"; then
    pactl load-module module-null-sink \
        sink_name=spotify-remote-audio \
        sink_properties=device.description=SpotifyRemoteAudio
fi

# Give PipeWire/WirePlumber a moment to finish initializing - there's no
# simple external signal to poll for this one (unlike the waits below),
# so a fixed wait is what this settled on
sleep 3

# Route audio to the virtual sink
pactl set-default-sink spotify-remote-audio
pactl set-sink-volume spotify-remote-audio 100%

# Optional: EasyEffects (https://github.com/wwmm/easyeffects, on
# Flathub) sits between Chromium and the virtual sink to level out
# loudness differences between tracks. Spotify does this itself with
# per-track loudness metadata it doesn't expose to outside apps (and
# the Web API endpoint that used to expose it is deprecated), so this
# is a live approximation instead, via EasyEffects' Auto Gain effect -
# expect a gradual gain drift after a track change rather than an
# instant correction, since it reacts to what it measures rather than
# knowing a track's loudness ahead of time. On its first launch, it
# automatically targets whatever the current default sink is
# (spotify-remote-audio here) and remembers that choice - nothing to
# configure by hand for routing. Install it, then add "Auto Gain" from
# the Output tab and set: Reference "Integrated", Max History 60s,
# Target -20dB (a short history reacts too abruptly to track changes).
# Settings persist automatically once set.
#   flatpak install flathub com.github.wwmm.easyeffects
flatpak run com.github.wwmm.easyeffects &

# AudioRelay only depends on the virtual sink above, not on Chromium or
# EasyEffects, so it's launched right alongside EasyEffects rather than
# sequenced after anything. Getting that audio onto your phone is a
# separate concern from the remote itself, but AudioRelay
# (https://audiorelay.net, available on Flathub) is what this project
# actually uses for it - picked after trying a few DIY alternatives (a
# VLC/ffmpeg stream captured from a virtual sink, played through a
# browser `<audio>` tag) that turned out heavier on CPU, or came with
# real playback drawbacks (growing latency behind live audio, since a
# plain `<audio>` element can't skip ahead to "now" the way
# purpose-built low-latency protocols can) — AudioRelay just works
# better for this. Install it first:
#   flatpak install flathub net.audiorelay.AudioRelay
flatpak run net.audiorelay.AudioRelay &

# Wait for EasyEffects' own PipeWire node to exist, so Chromium's audio
# stream gets picked up by the effect chain from the very first sound
# it makes, instead of possibly routing straight to the virtual sink
until pactl list short sinks | grep -q easyeffects; do
    sleep 0.2
done

# Launch the Chromium instance this project drives via CDP
chromium-browser \
  --user-data-dir="$HOME/.config/chromium-spotify" \
  --remote-debugging-port=9222 \
  --start-maximized &

# Wait for Chromium's remote debugging port to actually answer, rather
# than guessing a fixed delay
until curl -s http://127.0.0.1:9222/json/version >/dev/null 2>&1; do
    sleep 0.2
done

# Launch the server itself - adjust the path below if you cloned this
# repo somewhere other than ~/spotify-remote. Logging to a file here
# instead of just discarding output, since debugging an autostarted
# process is otherwise harder than running `node server.js` by hand in
# a terminal (which is still worth doing while actively developing -
# this is for a settled, day-to-day setup)
(cd "$HOME/spotify-remote" && node server.js >> "$HOME/spotify-remote/server.log" 2>&1) &
